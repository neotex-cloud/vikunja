#!/usr/bin/env bash
# next-release <current-tag>
# Prints the newest stable upstream tag (vX.Y.Z, no -suffix) that is newer
# than <current-tag>, or nothing when there is none. Reads local tags, so
# fetch upstream tags first. Always exits 0.
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: next-release <current-tag>" >&2
  exit 2
fi
current=$1

newest=$(git tag -l 'v*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1 || true)
[ -n "$newest" ] || exit 0
[ "$newest" != "$current" ] || exit 0

higher=$(printf '%s\n%s\n' "$current" "$newest" | sort -V | tail -n 1)
if [ "$higher" = "$newest" ]; then
  echo "$newest"
fi
